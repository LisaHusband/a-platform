# A-PLATFORM 部署配置示例 / deployment config example.
# 部署脚本读取这些变量；GitHub Actions 通过 SSH 注入，或在服务器
# ${DEPLOY_PATH}/shared/.env 中持久化运行期变量。
# Scripts read these vars; GitHub Actions injects them over SSH, or persist
# runtime vars in ${DEPLOY_PATH}/shared/.env on the server.

# --- 部署目标 / deploy target ---
DEPLOY_PATH=/www/wwwroot/a-platform
SERVICE_NAME=a-platform
SERVICE_USER=deploy
KEEP_RELEASES=5

# --- 域名与证书 / domain & TLS ---
DOMAIN_NAME=www.a-platform.tech
SSL_EMAIL=ops@a-platform.tech
SSL_RENEW_THRESHOLD_DAYS=30
ACME_WEBROOT=/www/wwwroot/a-platform/shared/acme

# --- Nginx ---
NGINX_CONF_PATH=/etc/nginx/sites-enabled/a-platform.conf

# --- 应用运行期 / application runtime (written to shared/.env) ---
BACKEND_PORT=18321
APLATFORM_SECRET=change-this-to-a-long-random-secret-string
APLATFORM_DB=/www/wwwroot/a-platform/shared/a_platform.db
# APLATFORM_VERSION 由部署脚本按 release id 自动写入 / set automatically per release

# --- 健康检查 / health check ---
HEALTH_PATH=/api/v1/health
